                        },
                        {
                          "type": "text",
                          "id": "NgQmX",
                          "x": 18,
                          "y": 93,
                          "name": "Среди пород собак наиболее подвержены риску развития дисплазии крупные представители. Владельцы таких животных должны с особой осторожностью относиться к здоровью суставов своих любимцев, регулярно посещая ветеринарного врача для диспансеризации.",
                          "fill": "#627384ff",
                          "textGrowth": "fixed-width-height",
                          "width": 306.8299865722656,
                          "height": 101,
                          "content": "Среди пород собак наиболее подвержены риску\nразвития дисплазии крупные представители.\nВладельцы таких животных должны с особой\nосторожностью относиться к здоровью суставов\nсвоих любимцев, регулярно посещая ветеринарного\nврача для диспансеризации.",
                          "lineHeight": 1.4166666666666667,
                          "textAlignVertical": "middle",
                          "fontFamily": "Onest",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        }
                      ]
