                {
                  "type": "text",
                  "id": "G56Pj",
                  "x": 24,
                  "y": 63,
                  "name": "Стерилизация автоматически делает животное малоподвижным и приводит к ожирению.",
                  "fill": "#2e3e55ff",
                  "textGrowth": "fixed-width-height",
                  "width": 301.90728759765625,
                  "height": 63.5,
                  "content": "Стерилизация автоматически делает\nживотное малоподвижным и приводит к\nожирению.",
                  "lineHeight": 1.55,
                  "textAlignVertical": "middle",
