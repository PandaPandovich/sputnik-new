                        },
                        {
                          "type": "text",
                          "id": "r9qL3w",
                          "x": 68,
                          "y": 43,
                          "name": "Собираем анамнез и проведём первичный осмотр животного. На этом этапе сможем определить распространённость патологического процесса, наличие осложняющих факторов.",
                          "fill": "#627384ff",
                          "textGrowth": "fixed-width-height",
                          "width": 247.64999389648438,
                          "height": 84,
                          "content": "Собираем анамнез и проведём первичный\nосмотр животного. На этом этапе сможем\nопределить распространённость\nпатологического процесса, наличие\nосложняющих факторов.",
                          "lineHeight": 1.4166666666666667,
                          "textAlignVertical": "middle",
                          "fontFamily": "Onest",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        }
