                          "fontFamily": "Onest",
                          "fontSize": 14,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "iQuP9",
                          "x": 18,
                          "y": 93,
                          "name": "Главная задача владельца собаки — постараться предотвратить развитие патологического процесса. Для этого очень важно следить за поддержанием веса у животного. Собаки с ожирением страдают от различных заболеваний суставов, в том числе и от дисплазии.",
                          "fill": "#627384ff",
                          "textGrowth": "fixed-width-height",
                          "width": 319.4700012207031,
                          "height": 101,
                          "content": "Главная задача владельца собаки — постараться\nпредотвратить развитие патологического процесса.\nДля этого очень важно следить за поддержанием веса\nу животного. Собаки с ожирением страдают от\nразличных заболеваний суставов, в том числе и от\nдисплазии.",
                          "lineHeight": 1.4166666666666667,
                          "textAlignVertical": "middle",
                          "fontFamily": "Onest",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        }
                      ]
