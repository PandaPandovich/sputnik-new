                        {
                          "type": "text",
                          "id": "WJaqh",
                          "x": 18,
                          "y": 66,
                          "name": "Heading 4 → Следить за весом собаки",
                          "fill": "#1d3658ff",
                          "textGrowth": "fixed-width-height",
                          "width": 175.47604370117188,
                          "height": 19,
                          "content": "Следить за весом собаки",
                          "lineHeight": 1.3571428571428572,
