                      "y": 32,
                      "name": "Диагностика",
                      "fill": "#1d3658ff",
                      "content": "Диагностика",
                      "lineHeight": 1.5,
                      "textAlignVertical": "middle",
                      "fontFamily": "Montserrat",
                      "fontSize": 16,
                      "fontWeight": "700"
                    },
                    {
                      "type": "text",
                      "id": "EGull",
                      "x": 562,
                      "y": 24,
                      "name": "Подготовим дополнительные анализы, уточним сопутствующие заболевания или противопоказания. Это будет наша отправная точка.",
                      "fill": "#103559ff",
                      "textGrowth": "fixed-width",
                      "width": 647,
                      "content": "Подготовим дополнительные анализы, уточним сопутствующие заболевания \nили противопоказания. Это будет наша отправная точка.",
                      "lineHeight": 1.4285714285714286,
                      "textAlignVertical": "middle",
                      "fontFamily": "Montserrat",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    },
