                        {
                          "type": "text",
                          "id": "VoH0w",
                          "x": 14,
                          "y": 43,
                          "name": "Современная ингаляционная анестезия — управляемая и безопасная. Риск у здорового молодого животного — менее 0,1%.",
                          "fill": "#1d3658ff",
                          "textGrowth": "fixed-width-height",
                          "width": 322.05999755859375,
                          "height": 52,
                          "content": "Современная ингаляционная анестезия — управляемая\nи безопасная. Риск у здорового молодого животного —\nменее 0,1%.",
                          "lineHeight": 1.5,
