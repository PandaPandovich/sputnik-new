                    {
                      "type": "text",
                      "id": "EDsky",
                      "x": 562,
                      "y": 14,
                      "name": "Собираем анамнез и проведем первичный осмотр животного. На этом этапе сможем определить распространенность онкологического процесса, наличие осложняющих факторов.",
                      "fill": "#103559ff",
                      "textGrowth": "fixed-width",
                      "width": 647,
                      "content": "Собираем анамнез и проведем первичный осмотр животного. \nНа этом этапе сможем определить распространенность онкологического процесса, \nналичие осложняющих факторов.",
                      "lineHeight": 1.4285714285714286,
                      "textAlignVertical": "middle",
                      "fontFamily": "Montserrat",
                      "fontSize": 14,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "text",
