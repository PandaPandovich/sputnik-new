                          "x": 68,
                          "y": 18,
                          "name": "Heading 4 → Исследования",
                          "fill": "#1d3658ff",
                          "textGrowth": "fixed-width-height",
                          "width": 99.49333953857422,
                          "height": 19,
                          "content": "Исследования",
                          "lineHeight": 1.3571428571428572,
