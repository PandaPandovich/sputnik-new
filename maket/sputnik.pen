                          "fontFamily": "Onest",
                          "fontSize": 14,
                          "fontWeight": "600"
                        },
                        {
                          "type": "text",
                          "id": "zbTEG",
                          "x": 68,
                          "y": 43,
                          "name": "Проведём цитологическое и/или гистологическое исследование, чтобы определить вид новообразования — злокачественный или доброкачественный. В зависимости от заболевания и состояния животного могут потребоваться сложные гистохимические исследования, компьютерная томография, лимфокартирование или другие исследования.",
                          "fill": "#627384ff",
                          "textGrowth": "fixed-width-height",
                          "width": 258.260009765625,
                          "height": 169,
                          "content": "Проведём цитологическое и/или\nгистологическое исследование, чтобы\nопределить вид новообразования —\nзлокачественный или доброкачественный. В\nзависимости от заболевания и состояния\nживотного могут потребоваться сложные\nгистохимические исследования,\nкомпьютерная томография,\nлимфокартирование или другие\nисследования.",
                          "lineHeight": 1.4166666666666667,
                          "textAlignVertical": "middle",
                          "fontFamily": "Onest",
                          "fontSize": 12,
                          "fontWeight": "normal"
                        }
                      ]
