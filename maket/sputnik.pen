                  "name": "Как проходит диагностика?",
                  "fill": "#103559ff",
                  "textGrowth": "fixed-width",
                  "width": 515,
                  "content": "Как проходит диагностика?",
                  "lineHeight": 1.100000023841858,
                  "textAlignVertical": "middle",
                  "fontFamily": "Montserrat",
