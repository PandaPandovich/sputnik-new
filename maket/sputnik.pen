                          "name": "Приём вёл врач: Анна Парицкая",
                          "fill": "#1d3658ff",
                          "textGrowth": "fixed-width-height",
                          "width": 188.0658721923828,
                          "height": 16,
                          "content": "Приём вёл врач: Анна Парицкая",
