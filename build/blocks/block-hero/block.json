{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "sputnik/hero",
  "title": "Hero Block",
  "category": "layout",
  "icon": "welcome-comments",
  "description": "Hero баннер-слайдер с заголовком, текстом и кнопкой",
