{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "sputnik/price-list",
    "title": "Price List Block",
    "category": "layout",
    "icon": "list-view",
    "description": "Блок с прайс-листом услуг",
    "keywords": [
        "price",
        "services",
        "цены",
        "услуги",
        "прайс"
